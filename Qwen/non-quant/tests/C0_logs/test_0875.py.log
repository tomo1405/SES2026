    def minkowski(u, v, p=2, w=None):
        """
        Compute the Minkowski distance between two arrays.
    
        The Minkowski distance between arrays `u` and `v`,
        is defined as
    
        .. math::
    
           {\\|u-v\\|}_p = (\\sum{|u_i - v_i|^p})^{1/p}.
    
    
           \\left(\\sum{w_i(|(u_i - v_i)|^p)}\\right)^{1/p}.
    
