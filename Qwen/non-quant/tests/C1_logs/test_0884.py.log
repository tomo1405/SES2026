        )
        autolag = string_like(
            autolag, "autolag", optional=True, options=("aic", "bic", "t-stat")
        )
        store = bool_like(store, "store")
        regresults = bool_like(regresults, "regresults")
    
        if x.max() == x.min():
            raise ValueError("Invalid input, x is constant")
    
        if regresults:
            store = True
    
        trenddict = {None: "n", 0: "c", 1: "ct", 2: "ctt"}
